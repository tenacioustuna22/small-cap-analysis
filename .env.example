# Copy this file to .env and fill it in. .env is git-ignored.
# The SEC asks automated clients to identify themselves with a name and contact email.
SEC_USER_AGENT=Your Name your.email@example.com

# Free CourtListener account API token (https://www.courtlistener.com/profile/api-token/),
# for the watchlist check's court dockets
COURTLISTENER_TOKEN=
